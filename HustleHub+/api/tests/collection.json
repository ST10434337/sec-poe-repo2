        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('reports API, database and rate-limit health', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "  pm.expect(body).to.have.property('Api');",
                  "  pm.expect(body.MongoDb.services.database).to.have.property('isHealthy');",
                  "  pm.expect(body.RateLimit).to.have.property('count');",
                  "  pm.expect(body.RateLimit).to.have.property('resetTime');",
                  "  pm.expect(pm.response.code === 200).to.eql(body.MongoDb.services.database.isHealthy);",
                  "});"
                ]
              }
            }
          ]
        },
