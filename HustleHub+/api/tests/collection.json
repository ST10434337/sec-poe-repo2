      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/auth/register (client)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{client_email}}\",\n  \"name\": \"{{client_name}}\",\n  \"password\": \"{{client_password}}\",\n  \"role\": \"client\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/auth/register"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('registers a client and returns a JWT', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.user.role).to.eql('client');",
                  "  pm.expect(body.user).not.to.have.property('password');",
                  "  pm.environment.set('client_token', body.token);",
                  "  pm.environment.set('auth_token', body.token);",
                  "  pm.environment.set('client_user_id', body.user.id);",
                  "});"
                ]
              }
            }
          ]
        },
